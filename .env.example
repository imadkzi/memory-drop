# Database
DATABASE_URL="postgresql://memory_drop:memory_drop@localhost:5432/memory_drop?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth / sessions
BETTER_AUTH_SECRET="replace-with-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Encrypt Google OAuth tokens at rest (64 hex chars = 32 bytes)
ENCRYPTION_KEY="replace-with-64-hex-characters-exactly-here-please-change"

# Google OAuth (Drive connection only — create in Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Upload limits
MAX_PHOTO_SIZE_BYTES="26214400"
MAX_VIDEO_SIZE_BYTES="1073741824"

# Rate limiting (guest upload sessions). Shared across instances via Redis.
RATE_LIMIT_UPLOAD_PER_IP="30"
RATE_LIMIT_UPLOAD_PER_TOKEN="60"
RATE_LIMIT_WINDOW_MS="600000"

# Redis (required in production). Local: brew services start redis
# or: docker compose up -d redis
REDIS_URL="redis://localhost:6379"

# Sentry. Leave blank to keep errors in logs only.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
